<!doctype html><html lang="ar" dir="rtl"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WOLF Repeater Pro</title>
<style>body{margin:0;background:#101014;color:#fff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Tahoma,sans-serif}main{max-width:650px;margin:auto;padding:16px}.card{background:#1b1920;border:1px solid #333;border-radius:16px;padding:15px;margin:12px 0}h1{margin:0 0 6px}label{display:block;color:#aaa;margin:10px 0 6px}input{width:100%;box-sizing:border-box;padding:12px;border-radius:10px;border:1px solid #444;background:#0b0b0e;color:#fff;font-size:16px}button{border:0;border-radius:10px;padding:11px 14px;margin:4px;font-weight:700}.g{background:#38bd6b}.r{background:#dc5959;color:#fff}.y{background:#dfba4b}.x{background:#393640;color:#fff}.status{background:#0c0c10;padding:11px;border-radius:10px;margin-top:9px}.row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.item{background:#25222b;padding:12px;border-radius:12px;margin:8px 0}.note{color:#888;font-size:12px;line-height:1.7}.empty{text-align:center;color:#777;padding:12px}</style>
<main><h1>🐺 WOLF Repeater Pro</h1><div class="note">اتصال يدوي — لا توجد إعادة اتصال تلقائية</div>
<div class="card"><h2>🔐 تسجيل الدخول</h2><label>الحساب / البريد</label><input id="email"><label>كلمة المرور</label><input id="pass" type="password"><button class="g" onclick="connect()">🔌 اتصال</button><button class="r" onclick="disconnect()">⛔ قطع</button><div id="status" class="status">غير متصل</div></div>
<div class="card"><h2>🏠 الغرفة</h2><label>رقم الغرفة</label><input id="room"><button class="y" onclick="room()">حفظ الغرفة</button></div>
<div class="card"><h2>🟢 جمع بطل</h2><div class="row"><input id="cm" type="number" min="0" value="3" placeholder="دقائق"><input id="cs" type="number" min="0" max="59" value="0" placeholder="ثواني"></div><button class="y" onclick="add('جمع بطل','')">+ إضافة الجمع</button></div>
<div class="card"><h2>⚔️ سطو بطل</h2><input id="rm" placeholder="العضوية المستهدفة"><div class="row"><input id="rmin" type="number" min="0" value="3" placeholder="دقائق"><input id="rsec" type="number" min="0" max="59" value="0" placeholder="ثواني"></div><button class="y" onclick="add('سطو بطل',rm.value)">+ إضافة السطو</button></div>
<div class="card"><h2>🏆 تحدي بطل</h2><input id="tm" placeholder="عضوية الخصم"><div class="row"><input id="tmin" type="number" min="0" value="1" placeholder="دقائق"><input id="tsec" type="number" min="0" max="59" value="0" placeholder="ثواني"></div><button class="y" onclick="add('تحدي بطل',tm.value)">+ إضافة التحدي</button></div>
<div class="card"><h2>📋 الأوامر</h2><div id="list" class="empty">لا توجد أوامر</div></div>
<script>
let a=JSON.parse(localStorage.getItem("wrp")||"[]"),t={};function save(){localStorage.setItem("wrp",JSON.stringify(a))}
function status(x){document.getElementById("status").textContent="الحالة: "+x.state+" — "+x.message+(x.room?" — الغرفة: "+x.room:"")}
async function connect(){let email=document.getElementById("email").value.trim(), password=document.getElementById("pass").value;if(!email||!password)return alert("أدخل الحساب وكلمة المرور");try{const response=await fetch("/api/connect",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email,password})});const x=await response.json();if(!response.ok){status({state:"خطأ",message:x?.message||response.statusText,room:document.getElementById("room").value.trim()});return;}status(x);}catch(err){status({state:"خطأ",message:err?.message||String(err),room:document.getElementById("room").value.trim()});}}
async function disconnect(){try{const response=await fetch("/api/disconnect",{method:"POST"});const x=await response.json();status(x);}catch(err){status({state:"خطأ",message:err?.message||String(err),room:document.getElementById("room").value.trim()});}}
async function room(){let r=document.getElementById("room").value.trim();try{const response=await fetch("/api/room",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({room:r})});const x=await response.json();status(x);}catch(err){status({state:"خطأ",message:err?.message||String(err),room:r});}}
function add(type,member){let m=type==="جمع بطل"?cm.value:type==="سطو بطل"?rmin.value:tmin.value,s=type==="جمع بطل"?cs.value:type==="سطو بطل"?rsec.value:tsec.value;if(type!=="جمع بطل"&&!member.trim())return alert("أدخل العضوية");a.push({type,member,min:+m||0,sec:+s||0,run:false});save();render()}
function render(){list.innerHTML=a.length?a.map((x,i)=>`<div class="item"><b>${x.type}</b><div class="note">${x.member?"العضوية: "+x.member+"<br>":""}الوقت: ${x.min} د ${x.sec} ث</div><button class="${x.run?"r":"g"}" onclick="toggle(${i})">${x.run?"⏸ إيقاف":"▶ تشغيل"}</button><button class="x" onclick="edit(${i})">✏️ تعديل</button><button class="x" onclick="del(${i})">🗑 حذف</button></div>`).join(""):"لا توجد أوامر"}
function toggle(i){a[i].run=!a[i].run;if(a[i].run){let ms=(a[i].min*60+a[i].sec)*1000||1000;t[i]=setInterval(()=>alert("حان موعد "+a[i].type+" — التنفيذ داخل WOLF لم يُربط بعد"),ms)}else clearInterval(t[i]);save();render()}
function edit(i){let x=a[i],m=prompt("الدقائق:",x.min),s=prompt("الثواني:",x.sec);if(m===null||s===null)return;x.min=+m||0;x.sec=Math.min(59,Math.max(0,+s||0));if(x.member){let q=prompt("العضوية:",x.member);if(q!==null)x.member=q}save();render()}
function del(i){clearInterval(t[i]);a.splice(i,1);save();render()}render();
</script></main>